# 正式实验的统一默认值。系统内部的 L 不要求取相同数值。
FVS_REPEATS="${FVS_REPEATS:-3}"
FVS_THREADS="${FVS_THREADS:-1}"
FVS_BEAMWIDTH="${FVS_BEAMWIDTH:-8}"
FVS_TOPK="${FVS_TOPK:-10}"

FVS_PIPEANN_HIGH_L="${FVS_PIPEANN_HIGH_L:-20 40 80}"
FVS_PIPEANN_REPRESENTATIVE_L="${FVS_PIPEANN_REPRESENTATIVE_L:-40}"
FVS_GATEANN_HIGH_L="${FVS_GATEANN_HIGH_L:-160 320 640}"
FVS_GATEANN_REPRESENTATIVE_L="${FVS_GATEANN_REPRESENTATIVE_L:-320}"
